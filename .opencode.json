{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
     "PROVIDERID": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MiniMax OpenAI-Compatible",
      "options": {
        "baseURL": "https://api.minimax.io/v1"
      },
      "models": {
        "MiniMax-M3": {
          "name": "MiniMax M3",
          "limit": {
            "context": 512000,
            "output": 64000
          },
          "reasoning": true,
          "tool_call": true,
          "options": {
            "reasoning_split": true
          },
          "cost": {
            "input": 3e-7,
            "output": 1.2e-6,
            "cache_read": 6e-8
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}